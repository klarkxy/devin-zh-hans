{
  "name": "devin-zh-hans",
  "displayName": "Devin 简体中文",
  "description": "为 Devin Desktop 提供完整简体中文界面：编辑器外壳、命令面板、设置项、内置扩展，以及 Agent 侧边栏与会话窗口。",
  "version": "1.2.0",
  "publisher": "devin-zh",
  "license": "MIT",
  "engines": {
    "vscode": "^1.126.0"
  },
  "categories": [
    "Language Packs"
  ],
  "keywords": [
    "devin",
    "windsurf",
    "chinese",
    "中文",
    "汉化",
    "localization"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "localizations": [
      {
        "languageId": "zh-cn",
        "languageName": "Chinese Simplified",
        "localizedLanguageName": "中文(简体)",
        "translations": [
          {
            "id": "vscode",
            "path": "./translations/main.i18n.json"
          },
          {
            "id": "windsurf",
            "path": "./translations/extensions/windsurf.i18n.json"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "devin-zh.status",
        "title": "查看汉化状态",
        "category": "Devin 中文"
      },
      {
        "command": "devin-zh.apply",
        "title": "重新应用汉化",
        "category": "Devin 中文"
      },
      {
        "command": "devin-zh.uninstall",
        "title": "卸载汉化并回滚",
        "category": "Devin 中文"
      }
    ]
  }
}



